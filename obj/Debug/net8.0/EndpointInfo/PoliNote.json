              "$ref": "#/components/schemas/PublicEvent"
            },
            "nullable": true
          },
          "privateEvents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PrivateEvent"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "UserRole": {
        "enum": [
          "Admin",
          "Informant",
          "Student"
        ],
        "type": "string"
