@page "/activate"
@using PoliNote.Pages
@model ActivateModel
@{
    ViewData["Title"] = "Account activation";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h3 class="text-center mb-0">Set password</h3>
                </div>
                <div class="card-body">
                    <form id="activationForm">
                        <input type="hidden" id="token" value="@Model.Token" />

                        <div class="mb-3">
                            <label class="form-label">New password</label>
                            <input type="password" id="password" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Repeat password</label>
                            <input type="password" id="confirmPassword" class="form-control" required />
                        </div>

                        <button type="submit" class="btn btn-primary w-100">Sent</button>
                    </form>

                    <div id="message" class="mt-3 d-none alert"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.getElementById('activationForm').addEventListener('submit', async (e) => {
        e.preventDefault();

        const password = document.getElementById('password').value;
        const confirmPassword = document.getElementById('confirmPassword').value;
        const token = document.getElementById('token').value;
        const msgDiv = document.getElementById('message');

        if (password !== confirmPassword) {
            showMessage("The passwords are not identical!", "alert-danger");
            return;
        }

        try {
            const response = await fetch('/api/auth/activate', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ token, password })
            });

            if (response.ok) {
                showMessage("Your account has been activated! You can log in now.", "alert-success");
                document.getElementById('activationForm').classList.add('d-none');
            } else {
                const error = await response.text();
                showMessage("Error: " + error, "alert-danger");
            }
        } catch (err) {
            showMessage("A connection error occurred.", "alert-danger");
        }
    });

    function showMessage(text, className) {
        const msgDiv = document.getElementById('message');
        msgDiv.innerText = text;
        msgDiv.className = "mt-3 alert " + className;
        msgDiv.classList.remove('d-none');
    }
</script>