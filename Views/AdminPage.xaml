<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PoliNote.Views.AdminPage"
    Title="Admin">

    <VerticalStackLayout
        Padding="24"
        Spacing="20"
        VerticalOptions="Center">

        <Button
            Text="Zarządzaj użytkownikami"
            FontSize="18"
            HeightRequest="56"
            Command="{Binding OpenUsersCommand}" />

        <Button
            Text="Dodaj zajęcia"
            FontSize="18"
            HeightRequest="56"
            Command="{Binding OpenAddClassCommand}" />

    </VerticalStackLayout>
</ContentPage>