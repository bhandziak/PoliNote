<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PoliNote.Views.AddPublicEventPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:PoliNote.ViewModels"
    Title="Dodaj wydarzenie">

    <ContentPage.BindingContext>
        <viewModels:AddPublicEventViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Entry Placeholder="Tytuł" Text="{Binding Title}" />
            <Editor Placeholder="Opis" Text="{Binding Description}" />
            <Entry Placeholder="Lokalizacja" Text="{Binding Location}" />

            <DatePicker Date="{Binding Date}" />

            <TimePicker Time="{Binding StartTime}" />
            <TimePicker Time="{Binding EndTime}" />

            <Button
                Text="Zatwierdź"
                Command="{Binding SaveCommand}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>