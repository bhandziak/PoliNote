<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PoliNote.Views.SubjectsPage"
    Title="Przedmioty">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="20">

            <!-- ===== ZAPISANE PRZEDMIOTY ===== -->
            <Label
                Text="Twoje przedmioty"
                FontSize="20"
                FontAttributes="Bold" />

            <CollectionView
                ItemsSource="{Binding EnrolledSubjects}"
                SelectionMode="None">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="12" Margin="0,4">
                            <Grid ColumnDefinitions="*,Auto">

                                <VerticalStackLayout Spacing="4">
                                    <Label
                                        Text="{Binding SubjectName}"
                                        FontAttributes="Bold" />

                                    <Label
                                        Text="{Binding GroupName}"
                                        FontSize="12"
                                        TextColor="Gray" />
                                </VerticalStackLayout>

                                <Button
                                    Grid.Column="1"
                                    Text="Szczegóły"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenDetailsCommand}"
                                    CommandParameter="{Binding .}" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <!-- ===== DODAJ KURSY ===== -->
            <Label
                Text="Dodaj kursy"
                FontSize="18"
                FontAttributes="Bold"
                TextColor="Gray" />

            <CollectionView
                ItemsSource="{Binding AvailableSubjects}"
                SelectionMode="None">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="12" Margin="0,4" BackgroundColor="#F3F4F6">
                            <Grid ColumnDefinitions="*,Auto">

                                <VerticalStackLayout Spacing="4">
                                    <Label
                                        Text="{Binding SubjectName}"
                                        FontAttributes="Bold" />

                                    <Label
                                        Text="{Binding GroupName}"
                                        FontSize="12"
                                        TextColor="Gray" />
                                </VerticalStackLayout>

                                <Button
                                    Grid.Column="1"
                                    Text="Szczegóły"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenDetailsCommand}"
                                    CommandParameter="{Binding .}" />
                                </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>