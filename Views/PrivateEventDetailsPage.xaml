<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PoliNote.Views.PrivateEventDetailsPage"
             Title="PrivateEventDetailsPage">
    <ScrollView>
        <VerticalStackLayout Padding="20">

            <Label Text="{Binding Event.Title}" FontSize="22" FontAttributes="Bold"/>
            <Label Text="{Binding Event.Description}" />

            <Editor Placeholder="Twoja notatka"
            Text="{Binding Event.Note}" />

            <Button Text="Zapisz notatkę"
            Command="{Binding SaveNoteCommand}" />

            <Button Text="Usuń wydarzenie"
            Command="{Binding DeleteCommand}"
            TextColor="Red" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>