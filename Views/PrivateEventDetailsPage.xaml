<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PoliNote.Views.PrivateEventDetailsPage"
             Title="PrivateEventDetailsPage">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">

            <Label Text="{Binding Event.Title}"
                   FontSize="24"
                   FontAttributes="Bold" />

            <Label Text="{Binding Event.Description}" />

            <Label Text="{Binding Event.Date, StringFormat='{0:dd MMMM yyyy}'}" />
            <Label Text="{Binding Event.Time}" />
            <Label Text="{Binding Event.Location}" />

            <Label Text="Notatka"
                   FontAttributes="Bold"
                   Margin="0,20,0,0" />

            <Editor
                Text="{Binding NoteContent}"
                HeightRequest="120" />

            <Button
                Text="Zapisz notatkę"
                Command="{Binding SaveNoteCommand}" />

            <Button
                Text="Usuń wydarzenie"
                BackgroundColor="Tomato"
                Command="{Binding DeleteCommand}" />

            <Button
                Text="Zamknij"
                Command="{Binding CloseCommand}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>