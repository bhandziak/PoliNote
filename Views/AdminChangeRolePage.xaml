<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PoliNote.Views.AdminChangeRolePage"
    Title="Zmiana roli">

    <VerticalStackLayout Padding="16" Spacing="16">

        <Label
            Text="{Binding Username}"
            FontSize="20"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

        <Label
            Text="{Binding Email}"
            FontSize="12"
            TextColor="Gray"
            HorizontalOptions="Center" />

        <Label Text="Wybierz nową rolę" FontAttributes="Bold" />

        <RadioButton
            Content="Student"
            GroupName="roles"
            IsChecked="{Binding IsStudent}" />

        <RadioButton
            Content="Wykładowca"
            GroupName="roles"
            IsChecked="{Binding IsInformant}" />

        <RadioButton
            Content="Administrator"
            GroupName="roles"
            IsChecked="{Binding IsAdmin}" />

        <Button
            Text="Zatwierdź zmianę"
            Command="{Binding SaveCommand}"
            BackgroundColor="#2563EB"
            TextColor="White" />

        <Button
            Text="Anuluj"
            Command="{Binding CancelCommand}" />

    </VerticalStackLayout>
</ContentPage>