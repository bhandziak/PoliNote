<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PoliNote.Views.PublicEventDetailsPage"
    Title="Szczegóły wydarzenia">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label
                Text="{Binding Event.Title}"
                FontSize="24"
                FontAttributes="Bold" />

            <HorizontalStackLayout Spacing="8">
                <Label Text="📅" />
                <Label Text="{Binding Event.StartDate, StringFormat='{0:dddd, yyyy MMMM dd HH:mm}'}" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="8">
                <Label Text="📍" />
                <Label Text="{Binding Event.Location}" />
            </HorizontalStackLayout>

            <Label
                Text="Opis wydarzenia"
                FontAttributes="Bold"
                Margin="0,12,0,0" />

            <Label
                Text="{Binding Event.Description}"
                LineBreakMode="WordWrap" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>