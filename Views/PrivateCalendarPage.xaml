<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PoliNote.Views.PrivateCalendarPage"
    Title="Kalendarz prywatny">

    <VerticalStackLayout Padding="16" Spacing="12">

        <!-- Wybór daty -->
        <DatePicker Date="{Binding SelectedDate}" />

        <!-- Lista wydarzeń -->
        <CollectionView
            ItemsSource="{Binding Events}"
            SelectionMode="Single"
            SelectionChanged="OnEventSelected">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="12" Margin="0,6">
                        <VerticalStackLayout Spacing="4">
                            <Label
                                Text="{Binding Title}"
                                FontAttributes="Bold"
                                FontSize="16" />

                            <Label
                                Text="{Binding Date}"
                                FontSize="12"
                                TextColor="Gray" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        <!-- Dodaj wydarzenie -->
        <Button
            Text="Dodaj nowe wydarzenie"
            Command="{Binding AddCommand}"
            BackgroundColor="#2563EB"
            TextColor="White"
            CornerRadius="12" />

    </VerticalStackLayout>
</ContentPage>